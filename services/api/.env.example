# Puerto del servidor API
PUERTO=4000
# PostgreSQL de producción. Si se omite, se usa PGlite embebido en RUTA_DATOS_LOCAL (solo desarrollo).
DATABASE_URL=
RUTA_DATOS_LOCAL=./data/pglite
# Orígenes autorizados (web y Android/Capacitor), separados por comas
ORIGENES_PERMITIDOS=http://localhost:3000,capacitor://localhost,https://localhost
DURACION_SESION_DIAS=30
# Fase 3 (no se usa todavía). Las claves viven solo en el servidor.
ANTHROPIC_API_KEY=
CLAVE_BUSQUEDA=
